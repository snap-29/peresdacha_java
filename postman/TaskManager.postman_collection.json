          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{refreshToken}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"oldRefresh\", pm.collectionVariables.get(\"refreshToken\"));",
              "pm.collectionVariables.set(\"registeredToken\", pm.response.json().token);",
              "pm.collectionVariables.set(\"refreshToken\", pm.response.json().refreshToken);"
            ]
          }
        }
      ]
